generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  accounts     UserAccount[]
  contacts     Contact[]
  collections  Collection[]
  campaigns    Campaign[]

  @@map("users")
}

model Account {
  id              String        @id @default(cuid())
  name            String
  phoneNumber     String?       @map("phone_number")
  status          String
  lastError       String?       @map("last_error")
  lastConnectedAt DateTime?     @map("last_connected_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  users           UserAccount[]
  campaigns       Campaign[]
  chats           Chat[]
  authSession     WaAuthSession?
  authKeys        WaAuthKey[]

  @@index([status])
  @@map("accounts")
}

model UserAccount {
  userId    String @map("user_id")
  accountId String @map("account_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@map("user_accounts")
}

model Contact {
  id              String              @id @default(cuid())
  userId          String              @map("user_id")
  name            String?
  phoneRaw        String?             @map("phone_raw")
  phoneNormalized String?             @map("phone_normalized")
  data            String
  sourceFileName  String?             @map("source_file_name")
  rowIndex        Int?                @map("row_index")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections     CollectionContact[]
  campaignStates  CampaignContact[]
  chats           Chat[]

  @@index([userId, phoneNormalized])
  @@map("contacts")
}

model Collection {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  name      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts  CollectionContact[]

  @@unique([userId, name])
  @@map("collections")
}

model CollectionContact {
  collectionId String     @map("collection_id")
  contactId    String     @map("contact_id")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([collectionId, contactId])
  @@map("collection_contacts")
}

model Campaign {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  accountId      String            @map("account_id")
  name           String
  status         String
  startDate      DateTime?         @map("start_date")
  endDate        DateTime?         @map("end_date")
  configurations String
  summary        String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts       CampaignContact[]

  @@index([userId, status, createdAt])
  @@map("campaigns")
}

model CampaignContact {
  campaignId   String    @map("campaign_id")
  contactId    String    @map("contact_id")
  status       String
  attempts     Int       @default(0)
  error        String?
  processedAt  DateTime? @map("processed_at")
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_contacts")
}

model Chat {
  id         String        @id @default(cuid())
  accountId  String        @map("account_id")
  contactId  String?       @map("contact_id")
  remoteJid  String        @map("remote_jid")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([accountId, remoteJid])
  @@map("chats")
}

model ChatMessage {
  id          String    @id @default(cuid())
  chatId      String    @map("chat_id")
  direction   String
  content     String?
  payloadJson String?   @map("payload_json")
  status      String?
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model WaAuthSession {
  accountId String   @id @map("account_id")
  credsJson String   @map("creds_json")
  updatedAt DateTime @updatedAt @map("updated_at")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("wa_auth_sessions")
}

model WaAuthKey {
  accountId String   @map("account_id")
  keyType   String   @map("key_type")
  keyId     String   @map("key_id")
  valueJson String   @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, keyType, keyId])
  @@index([accountId, keyType])
  @@index([updatedAt])
  @@map("wa_auth_keys")
}
